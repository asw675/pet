{
  "name": "@pet-desktop/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/verify-build.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "rebuild:native": "electron-builder install-app-deps",
    "package:win": "pnpm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@pet-desktop/app-service": "workspace:*",
    "@pet-desktop/contracts": "workspace:*",
    "@pet-desktop/domain": "workspace:*",
    "better-sqlite3": "12.11.1",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-router": "4.6.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "43.8.4",
    "electron-builder": "26.16.1",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.11"
  }
}
